{
  "name": "poe-price-patch-desktop",
  "version": "1.0.1",
  "description": "POE1 / POE2 物价补丁桌面应用",
  "main": "out/main/index.js",
  "author": "POE Price Patch",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "vue-tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run typecheck && electron-vite build",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "dist": "npm run prepare:runtime && npm run build && electron-builder --publish never",
    "test:desktop": "node scripts/verify-desktop.mjs",
    "preview": "electron-vite preview",
    "test:runtime": "node scripts/verify-runtime.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "format": "prettier --write src tests scripts",
    "test:migration": "node scripts/verify-migration.mjs",
    "updates:configure": "node scripts/configure-software-updates.mjs",
    "updates:build": "tsx scripts/build-software-update.ts",
    "test:software-updates": "tsx scripts/verify-software-updates.ts"
  },
  "dependencies": {
    "builder-util-runtime": "9.7.0",
    "electron-log": "^5.2.0",
    "electron-store": "^10.0.0",
    "electron-updater": "6.8.9",
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@iconify/vue": "^4.1.2",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^44.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "naive-ui": "^2.41.0",
    "pinia": "^3.0.3",
    "playwright": "^1.55.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "unocss": "^66.5.1",
    "vite": "^7.0.6",
    "vue": "^3.5.18",
    "vue-tsc": "^3.0.0"
  },
  "build": {
    "appId": "com.poepricepatch.desktop",
    "productName": "POE 物价补丁",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "asar": true,
    "compression": "normal",
    "artifactName": "POE-Price-Patch-${version}-${arch}-Setup.${ext}",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".runtime",
        "to": "engine"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/update-config.json",
        "to": "update-config.json"
      },
      {
        "from": "resources/current-release.json",
        "to": "current-release.json"
      }
    ],
    "win": {
      "electronUpdaterCompatibility": ">=6.8.9",
      "icon": "resources/icon.png",
      "executableName": "物价补丁",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "generic",
      "url": "https://price-up.guangxi-5.zos.ctyun.cn/poe-updates/installer/"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "POE-Price-Patch-${version}-${arch}-Setup.${ext}"
    }
  }
}
